# Public site (required)
PUBLIC_SITE_URL=https://www.alreadyherellc.com
NEXT_PUBLIC_SITE_URL=https://www.alreadyherellc.com
COMMAND_CENTER_URL=https://app.alreadyherellc.com
NEXT_PUBLIC_COMMAND_CENTER_URL=https://app.alreadyherellc.com

# HTTPS certificate issuance (required on OCI/Caddy deployments)
ACME_EMAIL=dispatch@alreadyherellc.com

# Dispatch (required)
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=dispatch@alreadyherellc.com
# Temporary destination inbox for production dispatch testing.
DISPATCH_TO_EMAIL=alreadyherellc@gmail.com
# Optional fallback delivery provider.
FORMSPREE_ENDPOINT=

# Level-4 resiliency / context mesh
# Do not commit real secrets. Configure encrypted production variables in Vercel/hosting.
GATEWAY_URL=
LITELLM_MASTER_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
PROFITENGINE_URL=
PROFITENGINE_WEBHOOK_TOKEN=

# Runtime
NODE_ENV=development

# Optional form provider
FORM_PROVIDER=
FORM_PROVIDER_API_KEY=
FORM_PROVIDER_FORM_ID=

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional future services
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ProfitEngine webhook integration ─────────────────────────────────────────
# Required for notifyDispatch() and notifyBlogPost() to call the ProfitEngine API.
# Generate PROFITENGINE_WEBHOOK_TOKEN with: openssl rand -hex 32
# The token must match PROFITENGINE_WEBHOOK_TOKEN set in the profitengine Vercel project.
# Variable: PROFITENGINE_URL            (e.g. https://profitengine-tau.vercel.app)
# Variable: PROFITENGINE_WEBHOOK_TOKEN  (encrypted — set in Vercel production env only)

# ── ASI Engine ────────────────────────────────────────────────────────────────
# Auto-deploy switch: false = patches saved for review, true = live hot-swap
ASI_AUTO_DEPLOY=false
CLUSTER_SECRET=REPLACE_WITH_cluster_secret
# GEMINI_API_KEY already listed above (reused by ASI engine)
# ---- Video Engine ----
VIDEO_ENGINE_COMPILE=true
VIDEO_TEMPORAL_STRIDE=10
VIDEO_VARIANCE_THRESHOLD=0.012

# ── Polymarket Smart Wallet Tracker ───────────────────────────────────────────
# Real-time on-chain wallet tracker & Telegram alert engine. Alert-only by default.
# Do not commit real RPC keys, Telegram tokens, or API keys to source control.
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_HTTP_URLS=https://polygon-rpc.com,https://polygon.drpc.org,https://polygon-bor-rpc.publicnode.com
POLYMARKET_EXCHANGE_ADDRESSES=0xE111180000d2663C0091e4f400237545B87B996B,0xe2222d279d744050d28e00520010520000310F59,0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
POLYMARKET_CONDITIONAL_TOKENS_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
WATCHED_WALLETS=0x...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
POLYMARKET_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cl6mb8i9h0003e201j6li0diw/subgraphs/orderbook-subgraph/0.0.1/gn
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_CLOB_API_KEY=
POLYNODE_API_KEY=
POLYMARKET_MAX_SLIPPAGE_PCT=2.0
POLYMARKET_FIXED_ORDER_USD=50.0
POLYMARKET_MIN_PROFIT_USD=10000.0
POLYMARKET_MIN_WIN_RATE_PCT=65.0
POLYMARKET_MIN_SHARPE_RATIO=1.0
POLYMARKET_BLACKLIST_MARKET_IDS=
POLYMARKET_WHITELIST_ONLY=false
# OPT-IN safety brake. Must be explicitly set to true to enable any auto-execution path.
POLYMARKET_LIVE_EXECUTION=false
POLYMARKET_DB_PATH=./data/polymarket_tracker.db
POLYMARKET_AUDIT_LOG=./data/polymarket_audit.jsonl
POLYMARKET_LOG_LEVEL=INFO
