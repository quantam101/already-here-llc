# Public site (required)
PUBLIC_SITE_URL=https://www.alreadyherellc.com
NEXT_PUBLIC_SITE_URL=https://www.alreadyherellc.com
COMMAND_CENTER_URL=https://app.alreadyherellc.com
NEXT_PUBLIC_COMMAND_CENTER_URL=https://app.alreadyherellc.com

# HTTPS certificate issuance (required on OCI/Caddy deployments)
ACME_EMAIL=dispatch@alreadyherellc.com

# Dispatch
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=dispatch@alreadyherellc.com
DISPATCH_TO_EMAIL=alreadyherellc@gmail.com
FORMSPREE_ENDPOINT=

# Revenue Command internal control plane
# Generate with a password manager or: openssl rand -hex 32
REVENUE_COMMAND_INTERNAL_TOKEN=
# Local/OCI durable SQLite path. Do not use /tmp for authoritative production data.
REVENUE_COMMAND_DB_PATH=data/revenue-command.sqlite3
# Optional OCI health probe used by Revenue Command engineering telemetry.
OCI_BACKEND_BASE_URL=
OCI_BACKEND_SERVICE=already-here-oci-backend
OCI_BACKEND_HEALTH_TOKEN=

# Level-4 resiliency / context mesh
# Do not commit real secrets. Configure encrypted production variables in the approved hosting secret manager.
GATEWAY_URL=
LITELLM_MASTER_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
PROFITENGINE_URL=
PROFITENGINE_WEBHOOK_TOKEN=

# Runtime
NODE_ENV=development

# Optional form provider
FORM_PROVIDER=
FORM_PROVIDER_API_KEY=
FORM_PROVIDER_FORM_ID=

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional payment services
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ProfitEngine webhook integration
# Generate PROFITENGINE_WEBHOOK_TOKEN with: openssl rand -hex 32
# Variable: PROFITENGINE_URL            (e.g. https://app.alreadyherellc.com)
# Variable: PROFITENGINE_WEBHOOK_TOKEN  (encrypted — set in production env only)

# ASI Engine
ASI_AUTO_DEPLOY=false
CLUSTER_SECRET=
# Required internal API key for /api/enterprise/orchestrator (non-healthcheck GET and all POST).
AHFOS_INTERNAL_API_KEY=
# Secret for the /api/enterprise/cron GitHub Actions/scheduled worker.
AHFOS_CRON_SECRET=
ENTERPRISE_STORE_TYPE=sqlite
ENTERPRISE_SQLITE_PATH=data/enterprise-asios.db

# Video Engine
VIDEO_ENGINE_COMPILE=true
VIDEO_TEMPORAL_STRIDE=10
VIDEO_VARIANCE_THRESHOLD=0.012

# Docker-only required secrets; docker-compose fails closed if these are missing.
POSTGRES_PASSWORD=
N8N_BASIC_AUTH_PASSWORD=
