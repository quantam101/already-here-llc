# Public site (required)
PUBLIC_SITE_URL=https://www.alreadyherellc.com
NEXT_PUBLIC_SITE_URL=https://www.alreadyherellc.com
COMMAND_CENTER_URL=https://app.alreadyherellc.com
NEXT_PUBLIC_COMMAND_CENTER_URL=https://app.alreadyherellc.com

# HTTPS certificate issuance (required on OCI/Caddy deployments)
ACME_EMAIL=dispatch@alreadyherellc.com

# Dispatch (required)
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=dispatch@alreadyherellc.com
# Temporary destination inbox for production dispatch testing.
DISPATCH_TO_EMAIL=alreadyherellc@gmail.com
# Optional fallback delivery provider.
FORMSPREE_ENDPOINT=

# Level-4 resiliency / context mesh
# Do not commit real secrets. Configure encrypted production variables in Vercel/hosting.
GATEWAY_URL=
LITELLM_MASTER_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
PROFITENGINE_URL=
PROFITENGINE_WEBHOOK_TOKEN=

# Runtime
NODE_ENV=development

# Optional form provider
FORM_PROVIDER=
FORM_PROVIDER_API_KEY=
FORM_PROVIDER_FORM_ID=

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional future services
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ProfitEngine webhook integration ─────────────────────────────────────────
# Required for notifyDispatch() and notifyBlogPost() to call the ProfitEngine API.
# Generate PROFITENGINE_WEBHOOK_TOKEN with: openssl rand -hex 32
# The token must match PROFITENGINE_WEBHOOK_TOKEN set in the profitengine Vercel project.
# Variable: PROFITENGINE_URL            (e.g. https://profitengine-tau.vercel.app)
# Variable: PROFITENGINE_WEBHOOK_TOKEN  (encrypted — set in Vercel production env only)

# ── ASI Engine ────────────────────────────────────────────────────────────────
# Auto-deploy switch: false = patches saved for review, true = live hot-swap
ASI_AUTO_DEPLOY=false
CLUSTER_SECRET=REPLACE_WITH_cluster_secret
# Required internal API key for /api/enterprise/orchestrator (non-healthcheck GET and all POST).
# Generate with: openssl rand -hex 32
AHFOS_INTERNAL_API_KEY=
# Secret for the /api/enterprise/cron GitHub Actions/scheduled worker.
# Generate with: openssl rand -hex 32
AHFOS_CRON_SECRET=
# Enterprise orchestrator persistence: 'memory' (default/tests) or 'sqlite'
ENTERPRISE_STORE_TYPE=sqlite
ENTERPRISE_SQLITE_PATH=data/enterprise-asios.db
# GEMINI_API_KEY already listed above (reused by ASI engine)
# ---- Video Engine ----
VIDEO_ENGINE_COMPILE=true
VIDEO_TEMPORAL_STRIDE=10
VIDEO_VARIANCE_THRESHOLD=0.012

# ── Polymarket Smart Wallet Tracker ───────────────────────────────────────────
# Real-time on-chain wallet tracker & Telegram alert engine. Alert-only by default.
# Do not commit real RPC keys, Telegram tokens, or API keys to source control.
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_HTTP_URLS=https://polygon-rpc.com,https://polygon.drpc.org,https://polygon-bor-rpc.publicnode.com
POLYMARKET_EXCHANGE_ADDRESSES=0xE111180000d2663C0091e4f400237545B87B996B,0xe2222d279d744050d28e00520010520000310F59,0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
POLYMARKET_CONDITIONAL_TOKENS_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
WATCHED_WALLETS=0x...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
POLYMARKET_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cl6mb8i9h0003e201j6li0diw/subgraphs/orderbook-subgraph/0.0.1/gn
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_CLOB_API_KEY=
POLYNODE_API_KEY=
POLYMARKET_MAX_SLIPPAGE_PCT=2.0
POLYMARKET_FIXED_ORDER_USD=50.0
POLYMARKET_MIN_PROFIT_USD=10000.0
POLYMARKET_MIN_WIN_RATE_PCT=65.0
POLYMARKET_MIN_SHARPE_RATIO=1.0
POLYMARKET_BLACKLIST_MARKET_IDS=
POLYMARKET_WHITELIST_ONLY=false
# OPT-IN safety brake. Must be explicitly set to true to enable any auto-execution path.
POLYMARKET_LIVE_EXECUTION=false
# Optional secret to reveal watched wallets / credential presence on the status endpoint.
# If unset, the public status endpoint returns counts and risk thresholds only.
POLYMARKET_STATUS_SECRET=
POLYMARKET_DASHBOARD_SECRET=

# 90% win-rate style signal confluence (disabled by default).
POLYMARKET_CONFLUENCE_ENABLED=false
POLYMARKET_CONFLUENCE_THRESHOLD=0.20
POLYMARKET_CONFLUENCE_MIN_CONFIDENCE=50.0
POLYMARKET_CONFLUENCE_USE_ORDER_BOOK=true
POLYMARKET_CONFLUENCE_USE_MARKET_METADATA=true
POLYMARKET_CONFLUENCE_MAX_SPREAD_PCT=0.05

# Portfolio-level circuit breaker for copy-trading.
POLYMARKET_PORTFOLIO_DAILY_LOSS_LIMIT=200.00
POLYMARKET_PORTFOLIO_WEEKLY_LOSS_LIMIT=500.00
POLYMARKET_PORTFOLIO_MAX_DRAWDOWN_PCT=30.0
POLYMARKET_PORTFOLIO_MIN_WIN_RATE_PCT=50.0
POLYMARKET_PORTFOLIO_CONSECUTIVE_LOSS_LIMIT=5

# Paper trading (simulated $50 copy positions, no real capital)
POLYMARKET_PAPER_TRADING=false
POLYMARKET_PAPER_RECONCILE_INTERVAL_SECONDS=300
POLYMARKET_PAPER_STARTING_BANKROLL=1000.00

POLYMARKET_DB_PATH=./data/polymarket_tracker.db
POLYMARKET_AUDIT_LOG=./data/polymarket_audit.jsonl
POLYMARKET_LOG_LEVEL=INFO

# Alert time window (24-hour local clock). Default 04:00-06:00 America/Phoenix.
# Set to 0-24 UTC to receive alerts at all hours.
POLYMARKET_ALERT_START_HOUR=4
POLYMARKET_ALERT_END_HOUR=6
POLYMARKET_ALERT_TIMEZONE=America/Phoenix

# ── Claude signal summarizer (opt-in, requires ANTHROPIC_API_KEY equivalent) ──
#CLAUDE_API_KEY=
#POLYMARKET_CLAUDE_ENABLED=false
#POLYMARKET_CLAUDE_MODEL=claude-sonnet-5
#POLYMARKET_CLAUDE_MAX_TOKENS=120
#POLYMARKET_CLAUDE_TIMEOUT_SECONDS=4.0

# ---- Photo AI Haul Scanner ----
HAUL_SCANNER_HOST=0.0.0.0
HAUL_SCANNER_PORT=8000
HAUL_CORS_ORIGINS=*
HAUL_TRAILER_CAPACITY_CU_YD=10.6
HAUL_BASE_DISPATCH_FEE_USD=75.0
HAUL_RATE_PER_CU_YD_USD=38.0
HAUL_RECOVERY_CREDIT_PCT=0.25
HAUL_MAX_UPLOAD_BYTES=26214400
HAUL_PROCESS_TIMEOUT_SECONDS=30.0
HAUL_FRAME_WIDTH_METERS=2.5
HAUL_RATE_LIMIT_PER_MINUTE=30
# Single shared key (legacy) — prefer HAUL_API_KEYS for multi-tenant deployments.
# HAUL_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
# Multi-tenant keys: JSON object keyed by API key, or a list of objects with `key`.
# HAUL_API_KEYS={"key_abc":{"org":"acme","tier":"enterprise","rpm":1000,"daily_quota":10000}}
HAUL_CORS_ORIGINS=*
HAUL_LOG_JSON=false
# Optional Redis for global rate limits/quotas across pods.
# REDIS_URL=redis://redis:6379
# Optional per-org scan persistence / billing store. Use 'memory' for ephemeral.
# HAUL_SCAN_STORE=memory
# HAUL_SCAN_STORE=data/haul_scans.db
# Optional HMAC-SHA256 request signing secret for enterprise webhooks.
# HAUL_REQUEST_SIGNING_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# ---- YOLOv8 ONNX local object recognition ----
HAUL_YOLO_ENABLED=true
HAUL_YOLO_MODEL_PATH=models/yolov8n.onnx
# HAUL_VISION_SOURCE_ORDER=fused,cloud,deterministic
# HAUL_YOLO_CONF=0.55
# HAUL_YOLO_IOU=0.3
# HAUL_YOLO_MAX_DETECTIONS=8
# HAUL_YOLO_MIN_AREA_RATIO=0.01
# HAUL_YOLO_MAX_AREA_RATIO=0.5
# ---- TinyCLIP fine-grained zero-shot classification ----
HAUL_CLIP_ENABLED=true
# HAUL_CLIP_MODEL_DIR=models/tinyclip40
# HAUL_CLIP_CONF=8.0
# HAUL_CLIP_MAX_CANDIDATES=12
# ---- Feedback / training data collection ----
HAUL_FEEDBACK_ENABLED=true
# HAUL_FEEDBACK_STORE=data/haul_feedback.db
# HAUL_FEEDBACK_DIR=data/feedback
# HAUL_SAVE_SCAN_IMAGES=true
# HAUL_SCAN_IMAGES_DIR=data/scan_images
GMAOS_PAID_ADAPTERS_ENABLED=false
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
