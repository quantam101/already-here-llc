# Photo AI Haul Scanner — global enterprise container.
# Stateless FastAPI service; scales horizontally behind a load balancer.
FROM python:3.10-slim

WORKDIR /app

# Install security updates and dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py ./
COPY runtime/ ./runtime/
COPY public/ ./public/

# Download the YOLOv8n ONNX model and TinyCLIP 40M artifacts for trained object recognition.
RUN mkdir -p models/tinyclip40 && \
    python - <<'PY'
import urllib.request, os
urllib.request.urlretrieve('https://huggingface.co/Kalray/yolov8/resolve/main/yolov8n.onnx', 'models/yolov8n.onnx')
base = 'https://huggingface.co/onnx-community/TinyCLIP-ViT-40M-32-Text-19M-LAION400M-ONNX/resolve/main'
for path in ['onnx/model_q4f16.onnx', 'tokenizer.json', 'preprocessor_config.json', 'config.json']:
    urllib.request.urlretrieve(f'{base}/{path}', f'models/tinyclip40/{os.path.basename(path)}')
PY

# Non-root runtime user.
RUN groupadd -r haul && useradd -r -g haul -u 1000 haul
RUN mkdir -p /tmp /data && chown -R haul:haul /app /tmp /data
USER 1000

ENV HAUL_SCANNER_HOST=0.0.0.0
ENV HAUL_SCANNER_PORT=8000
ENV GMAOS_MODE=strict_zero_spend
ENV GMAOS_PAID_ADAPTERS_ENABLED=false

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')" || exit 1

CMD ["python", "app.py"]
