# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

# Install dependencies first for layer caching
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy runtime modules
COPY runtime/ ./runtime/

# Persistent data and backup directories
RUN mkdir -p /data /backups
VOLUME ["/data", "/backups"]

ENV CANONICAL_SQLITE_PATH=/data/oci-canonical-graph.db
ENV CANONICAL_BACKUP_DIR=/backups
ENV CANONICAL_HOST=0.0.0.0
ENV CANONICAL_PORT=8443

EXPOSE 8443

CMD ["python", "-m", "uvicorn", "runtime.oci_canonical_server:app", "--host", "0.0.0.0", "--port", "8443"]
